generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================
// ENUMS
// ====================

enum ProjectRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// ====================
// USER
// ====================

model User {
  id       String @id @default(uuid())
  nickName String @unique
  email    String @unique
  password String

  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces    WorkspaceMember[]
  projects      ProjectMember[]
  assignedTasks Task[]
  comments      Comment[]
  taskStatusChanges TaskStatusHistory[] @relation("TaskStatusHistoryChangedBy")
}

// ====================
// WORKSPACE
// ====================

model Workspace {
  id   String @id @default(uuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  projects Project[]
}

// ====================
// WORKSPACE MEMBERS
// ====================

model WorkspaceMember {
  id String @id @default(uuid())

  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

// ====================
// PROJECT
// ====================

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  members ProjectMember[]
  tasks   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, createdAt, id])
}

// ====================
// PROJECT MEMBERS
// ====================

model ProjectMember {
  id String @id @default(uuid())

  role ProjectRole @default(MEMBER)

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
}

// ====================
// TASK
// ====================

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate  DateTime?

  projectId  String
  assigneeId String?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  comments Comment[]
  statusHistory TaskStatusHistory[] @relation("TaskStatusHistoryTask")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, createdAt, id])
  @@index([projectId, status, createdAt, id])
  @@index([projectId, priority, createdAt, id])
  @@index([projectId, assigneeId, createdAt, id])
  @@index([dueDate])
}

// ====================
// COMMENT
// ====================

model Comment {
  id      String @id @default(uuid())
  content String

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([taskId, createdAt, id])
  @@index([userId])
}

// ====================
// TASK STATUS HISTORY
// ====================

model TaskStatusHistory {
  id String @id @default(uuid())

  taskId      String
  changedById String
  oldStatus   TaskStatus
  newStatus   TaskStatus

  task      Task @relation("TaskStatusHistoryTask", fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation("TaskStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([taskId, createdAt, id])
  @@index([changedById])
}
